{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AtlynCo/powerbi-financial-matrix/blob/main/samples/line-metadata.schema.json",
  "title": "Atlyn Financial Matrix line metadata",
  "description": "Declarative presentation only. Runtime additionally rejects duplicate JSON properties/IDs, duplicate sibling sort positions and unknown delivered IDs.",
  "type": "array",
  "minItems": 1,
  "maxItems": 1000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "label", "order", "type", "unit", "sign", "favorable", "variance"],
    "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
      "label": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
      "order": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
      "type": { "enum": ["detail", "subtotal", "heading"] },
      "unit": { "enum": ["currency", "percent", "number"] },
      "format": { "type": "string", "minLength": 1, "maxLength": 100 },
      "sign": { "enum": [1, -1] },
      "favorable": { "enum": ["higher", "lower", "neutral"] },
      "variance": { "enum": ["none", "absolute", "both"] }
    },
    "allOf": [
      { "if": { "properties": { "unit": { "const": "percent" } } }, "then": { "properties": { "variance": { "enum": ["none", "absolute"] } } } },
      { "if": { "properties": { "type": { "const": "heading" } } }, "then": { "properties": { "variance": { "const": "none" } } } }
    ]
  }
}
